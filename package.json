{
  "name": "n8n-nodes-atproto",
  "version": "0.1.0",
  "description": "Generic AT Protocol node for n8n — CRUD any record in any lexicon",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "main": "dist/nodes/Atproto/Atproto.node.js",
  "author": {
    "name": "Andri Óskarsson",
    "url": "https://andri.dk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrioid/n8n-nodes-atproto.git"
  },
  "homepage": "https://github.com/andrioid/n8n-nodes-atproto",
  "scripts": {
    "setup:dev": "node scripts/patch-node-js-exports.mjs",
    "dev": "n8n-node dev",
    "build": "vite build --config vite.config.build.ts",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AtprotoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Atproto/Atproto.node.js",
      "dist/nodes/Atproto/AtprotoJetstream.trigger.js"
    ]
  },
  "devDependencies": {
    "@atproto/api": "^0.20.6",
    "@atproto/lexicon-resolver": "^0.4.0",
    "@n8n/node-cli": "^0.32.0",
    "eslint": "^9.29.0",
    "msw": "^2.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.0.0",
    "vitest": "latest",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
